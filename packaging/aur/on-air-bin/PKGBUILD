# Maintainer: Shay <tsonubin@users.noreply.github.com>
# Prebuilt on-air for Omarchy / Arch: the release's on-air-core and on-air
# (terminal UI) binaries, plus the systemd user unit, launcher entry, icon
# and Omarchy snippets from the same tag. No Rust toolchain or compile step,
# which matters on older laptops. `on-air` is the same thing built from source.
pkgname=on-air-bin
pkgver=0.2.0
pkgrel=1
pkgdesc='LAN audio to AirPlay, Bluetooth or Sonos: core service and terminal UI (prebuilt)'
arch=('x86_64' 'aarch64')
url="https://github.com/tsonubin/on-air"
license=('MIT')
depends=('alsa-lib' 'openssl' 'libpulse' 'bluez-utils' 'xdg-terminal-exec' 'hicolor-icon-theme')
optdepends=('owntone-server: AirPlay through OwnTone, with PIN pairing'
            'uv: AirPlay without OwnTone, through pyatv')
provides=('on-air' 'on-air-core')
conflicts=('on-air' 'on-air-core')
install=on-air.install
options=('!strip' '!debug')
_raw="https://raw.githubusercontent.com/tsonubin/on-air/v${pkgver}"
_rel="https://github.com/tsonubin/on-air/releases/download/v${pkgver}"
# Packaging files from the tag; their checksums are checked against the
# repository by packaging/omarchy/test.sh.
# The license is saved as on-air-LICENSE: a source named LICENSE would be
# shadowed by this recipe's own 0BSD LICENSE next to the PKGBUILD.
source=(
        "on-air-LICENSE::${_raw}/LICENSE"
        "on-air-core.service::${_raw}/packaging/omarchy/on-air-core.service"
        "on-air.desktop::${_raw}/packaging/omarchy/on-air.desktop"
        "on-air.svg::${_raw}/packaging/omarchy/on-air.svg"
        "omarchy-menu.jsonc::${_raw}/packaging/omarchy/snippets/omarchy-menu.jsonc"
        "bindings.lua::${_raw}/packaging/omarchy/snippets/bindings.lua"
        "bindings.conf::${_raw}/packaging/omarchy/snippets/bindings.conf"
        "hyprland-rules.lua::${_raw}/packaging/omarchy/snippets/hyprland-rules.lua"
        "hyprland-rules.conf::${_raw}/packaging/omarchy/snippets/hyprland-rules.conf"
        "shell-bar.json::${_raw}/packaging/omarchy/snippets/shell-bar.json"
        "waybar.jsonc::${_raw}/packaging/omarchy/snippets/waybar.jsonc"
)
source_x86_64=("on-air-core-${pkgver}-x86_64::${_rel}/on-air-core-serve-linux-x86_64"
               "on-air-tui-${pkgver}-x86_64::${_rel}/on-air-tui-linux-x86_64")
source_aarch64=("on-air-core-${pkgver}-aarch64::${_rel}/on-air-core-serve-linux-aarch64"
                "on-air-tui-${pkgver}-aarch64::${_rel}/on-air-tui-linux-aarch64")
sha256sums=(
            '38dae14fca3e1311278dee423daf62ec11047d37ce12182ad33202f1bf6baee5'
            'c5ff635f22112c32ee0b28deb1edf5e6bf8ab2c4840f029e99d0fc40872c974e'
            '6076fa1c5b91c21fac2db3f36d1a559eee7f332c9406376546ac26d4445a0587'
            '085569f4f6034b58fc0232b8c61cb8d6e8719e2e93bd68794a2db2eae572672a'
            '1d6d97e248645cb0a58cf4f60e45dcd5d526da91309b0f98daeb9e95a1656e34'
            '803d4b5039fbb605e5e25daffc97631a5e7e4707e623ae551c952c2720c7552a'
            '2d8ee5acd1e2c2b669d376e24e0483dd2e7041b8f8f4d4f7ed79dab04b70e723'
            '0c6991ff06fc77f4d3e019d5fa05b337f49c5ab569348b47ceb83b71f9cedca6'
            '7c1a2fe81190e755474656fb85691553b7c39d28f0277849720512e8aae46919'
            '894fe86f379ccdc67672a32acac41405870c2a339c40f0f8612b495eaf406c23'
            '187677a6b2f1671a8776b41fc7db8a78f1bc631ffd81c847311ba3cca7376f15'
)
# Filled by packaging/update-checksums.sh from the release's SHA256SUMS.
sha256sums_x86_64=('SKIP' 'SKIP')
sha256sums_aarch64=('SKIP' 'SKIP')

package() {
  cd "$srcdir"
  install -Dm755 "on-air-core-${pkgver}-${CARCH}" "$pkgdir/usr/bin/on-air-core"
  install -Dm755 "on-air-tui-${pkgver}-${CARCH}" "$pkgdir/usr/bin/on-air"
  install -Dm644 on-air-core.service "$pkgdir/usr/lib/systemd/user/on-air-core.service"
  install -Dm644 on-air.desktop "$pkgdir/usr/share/applications/on-air.desktop"
  install -Dm644 on-air.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/on-air.svg"
  install -Dm644 on-air-LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -dm755 "$pkgdir/usr/share/doc/on-air/omarchy"
  install -m644 omarchy-menu.jsonc bindings.lua bindings.conf hyprland-rules.lua \
    hyprland-rules.conf shell-bar.json waybar.jsonc "$pkgdir/usr/share/doc/on-air/omarchy/"
}
