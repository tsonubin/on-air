# Maintainer: Shay <tsonubin@users.noreply.github.com>
pkgname=on-air-desktop-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="LAN audio streaming to AirPlay, Bluetooth, or Sonos (WebKitGTK desktop window; on Omarchy prefer on-air-bin)"
arch=('x86_64' 'aarch64')
url="https://github.com/tsonubin/on-air"
license=('MIT')
depends=('gtk3' 'webkit2gtk-4.1' 'libayatana-appindicator' 'librsvg' 'alsa-lib' 'openssl' 'hicolor-icon-theme')
makedepends=('binutils')
provides=('on-air-desktop')
conflicts=('on-air-desktop')
options=('!strip' '!debug')
source=("LICENSE::https://raw.githubusercontent.com/tsonubin/on-air/v${pkgver}/LICENSE")
sha256sums=('38dae14fca3e1311278dee423daf62ec11047d37ce12182ad33202f1bf6baee5')
source_x86_64=("on-air-desktop_${pkgver}_amd64.deb::https://github.com/tsonubin/on-air/releases/download/v${pkgver}/on-air-desktop_${pkgver}_amd64.deb")
source_aarch64=("on-air-desktop_${pkgver}_arm64.deb::https://github.com/tsonubin/on-air/releases/download/v${pkgver}/on-air-desktop_${pkgver}_arm64.deb")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  local deb
  case "$CARCH" in
    x86_64) deb="on-air-desktop_${pkgver}_amd64.deb" ;;
    aarch64) deb="on-air-desktop_${pkgver}_arm64.deb" ;;
  esac
  cd "$srcdir"
  ar x "$deb"
  tar -xf data.tar.* -C "$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
