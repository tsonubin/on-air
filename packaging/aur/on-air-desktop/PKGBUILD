# Maintainer: Shay <tsonubin@users.noreply.github.com>
# Source build of the desktop GUI. Not published to the AUR yet.
# Install this checkout with ../../install.sh (uses yay).
# The pinned commit is current main; bump it when cutting a release.
pkgname=on-air-desktop
pkgver=0.1.0
pkgrel=1
pkgdesc='LAN audio streaming to AirPlay, Bluetooth, or Sonos (desktop GUI)'
arch=('x86_64' 'aarch64')
url='https://github.com/tsonubin/on-air'
license=('custom:unknown')
depends=(
  'gtk3'
  'webkit2gtk-4.1'
  'libayatana-appindicator'
  'librsvg'
  'alsa-lib'
  'openssl'
  'hicolor-icon-theme'
  'libpulse'
  'bluez-utils'
  'python'
)
makedepends=(
  'cargo'
  'rust'
  'nodejs'
  'npm'
  'pkgconf'
  'gtk3'
  'webkit2gtk-4.1'
  'libayatana-appindicator'
  'librsvg'
  'alsa-lib'
  'openssl'
)
provides=('on-air')
conflicts=('on-air' 'on-air-bin')
options=('!lto' '!debug')
source=(
  "on-air::git+https://github.com/tsonubin/on-air.git#commit=0c4fdcb0e05711fbebf31e9938c90a4af88bd948"
  'com.shay.on-air.desktop'
)
sha256sums=(
  'SKIP'
  '2bbc4c848106096ef79fa19be590943da36bf92acf96503a320c36f6ace9c36d'
)

prepare() {
  cd on-air
  export CARGO_HOME="${srcdir}/.cargo"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd on-air
  export CARGO_HOME="${srcdir}/.cargo"
  export PATH="/usr/bin:${PATH}"
  if [[ ! -x "${srcdir}/pnpm-prefix/node_modules/.bin/pnpm" ]]; then
    npm install --prefix "${srcdir}/pnpm-prefix" pnpm@9.15.0
  fi
  export PATH="${srcdir}/pnpm-prefix/node_modules/.bin:${PATH}"
  pnpm install --frozen-lockfile --filter 'desktop...'
  pnpm --filter desktop build
  cargo build --locked --release -p on-air-desktop
}

package() {
  cd on-air
  install -Dm755 target/release/on-air-desktop "${pkgdir}/usr/bin/on-air-desktop"
  install -Dm644 "${srcdir}/com.shay.on-air.desktop" \
    "${pkgdir}/usr/share/applications/com.shay.on-air.desktop"
  local icon_root="${pkgdir}/usr/share/icons/hicolor"
  install -Dm644 apps/desktop/src-tauri/icons/32x32.png \
    "${icon_root}/32x32/apps/com.shay.on-air.png"
  install -Dm644 apps/desktop/src-tauri/icons/128x128.png \
    "${icon_root}/128x128/apps/com.shay.on-air.png"
  install -Dm644 apps/desktop/src-tauri/icons/128x128@2x.png \
    "${icon_root}/256x256/apps/com.shay.on-air.png"
  install -Dm644 apps/desktop/src-tauri/icons/icon.png \
    "${icon_root}/512x512/apps/com.shay.on-air.png"
  install -Dm644 apps/desktop/src-tauri/icons/128x128@2x.png \
    "${icon_root}/256x256/apps/on-air-desktop.png"
}
