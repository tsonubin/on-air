{
  "expo": {
    "name": "on-air remote",
    "slug": "on-air-remote",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "scheme": "onair",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.onair.remote",
      "buildNumber": "2",
      "icon": "./assets/AppIcon.icon",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "on-air remote finds the desktop mixer on your LAN.",
        "NSBonjourServices": ["_on-air._tcp."],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.onair.remote",
      "permissions": ["ACCESS_NETWORK_STATE", "CHANGE_WIFI_MULTICAST_STATE", "INTERNET"]
    },
    "plugins": ["expo-secure-store"],
    "extra": {
      "eas": {
        "projectId": "6d6a9d12-1cf3-4458-8e5b-9dd27e357c98"
      }
    },
    "owner": "tsonubin"
  }
}
