{
  "name": "on-air",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "pnpm --filter desktop tauri dev",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:mobile": "pnpm --filter @on-air/control-client test && pnpm --filter mobile test",
    "test:mobile:e2e": "node --experimental-strip-types --test e2e/mobile/companion.e2e.ts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@react-native/jest-preset": "0.86.3"
    }
  }
}
