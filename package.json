{
  "name": "on-air",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "pnpm --filter desktop tauri dev",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "turbo run build",
    "check": "biome check .",
    "check:ci": "biome ci .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "turbo run test",
    "test:mobile": "pnpm --filter @on-air/control-client test && pnpm --filter mobile test",
    "test:mobile:e2e": "pnpm --filter @on-air/e2e test:mobile",
    "test:native": "pnpm --filter @on-air/e2e test:native",
    "test:desktop:e2e": "pnpm --filter @on-air/e2e test:desktop",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "pnpm --filter @on-air/api-types typecheck && pnpm --filter @on-air/control-client typecheck && pnpm --filter desktop typecheck && pnpm --filter mobile typecheck && pnpm --filter @on-air/e2e typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "^2.11.8"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
